# ================= ENVIRONMENT =================
# para produção deixar em= production
# para teste deixar em= teste
NODE_ENV=escolha_sua_opcao

# ================= DATABASE =================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=nome_do_seu_banco_aqui

# ================= JWT =================
JWT_SECRET=sua_chave_secreta_muito_longa_e_aleatoria
JWT_EXPIRES=8h

# ================= SESSION =================
SESSION_MAX_AGE_MS=28800000

# ================= CLOUDINARY =================
CLOUD_NAME=seu_cloud_name
API_KEY=sua_api_key
API_SECRET=seu_api_secret

# ================= Firebase Admin SDK =================
# Prefira armazenar isso no ambiente do provedor de hosting / servidor.
# Exemplo: FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
FIREBASE_SERVICE_ACCOUNT=sua_chave_secreta_aqui

# ================= CORS =================
# Em produção, liste os domínios separados por vírgula
ALLOWED_ORIGINS=https://seudominio.com,https://www.seudominio.com

# ================= SERVER =================
PORT=3000

# ================= SUPERADMIN =================
DEFAULT_SUPERADMIN_EMAIL=admin@exemplo.com
DEFAULT_SUPERADMIN_PASSWORD=mudar_isso_em_producao

# ================= ASSINATURAS VENDLY =================
# Trial inicial aplicado somente a novos estabelecimentos. Legados sem
# assinatura permanecem em estado nao_configurada e nao sao bloqueados.
ASSINATURA_TRIAL_DIAS=dias_desejados

# ================= SEGURANÇA =================
ENCRYPTION_SECRET=sua_chave_de_32_bytes_ou_mais
ENCRYPTION_SALT=sua_salt_aleatoria
MERCADOPAGO_WEBHOOK_SECRET=seu_webhook_secret
FIREBASE_WEB_API_KEY=sua_firebase_web_api_key
